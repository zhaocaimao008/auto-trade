# ── 数据源 ──────────────────────────────────────────────
TUSHARE_TOKEN=
DEFAULT_DATA_SOURCE=akshare       # akshare | tushare

# ── 数据库 ──────────────────────────────────────────────
DB_URL=sqlite:///auto_trader.db

# ── 交易时间 ────────────────────────────────────────────
MARKET_CLOSE_HOUR=15
MARKET_CLOSE_MINUTE=0

# ── Broker 类型 ─────────────────────────────────────────
# mock       → 模拟交易（默认，无风险）
# easytrader → 实盘交易（通过 easytrader 连接券商客户端）
BROKER_TYPE=mock

# ── EasyTrader 实盘配置（仅 BROKER_TYPE=easytrader 时需要）─
EASYTRADER_BROKER_TYPE=ht         # ht=华泰, yjb=银河, gf=广发
EASYTRADER_ACCOUNT=
EASYTRADER_PASSWORD=
EASYTRADER_EXE_PATH=              # 如: C:\\ht\\xiadan.exe
